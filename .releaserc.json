{
    "branches": [
        "main"
    ],
    "plugins": [
        [
            "@semantic-release/commit-analyzer",
            {
                "preset": "conventionalcommits",
                "releaseRules": [
                    {
                        "type": "build",
                        "scope": "deps",
                        "release": "patch"
                    }
                ]
            }
        ],
        [
            "@semantic-release/release-notes-generator",
            {
                "preset": "conventionalcommits",
                "presetConfig": {
                    "types": [
                        {
                            "type": "feat",
                            "section": "Features"
                        },
                        {
                            "type": "fix",
                            "section": "Bug Fixes"
                        },
                        {
                            "type": "build",
                            "section": "Dependencies and Other Build Updates",
                            "hidden": false
                        }
                    ]
                }
            }
        ],
        "@semantic-release/git",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "uv version --frozen <%= nextRelease.version %> && uv build --no-sources && echo 'distributions-built=true' >> \"$GITHUB_OUTPUT\""
            }
        ],
        "@semantic-release/github"
    ]
}
